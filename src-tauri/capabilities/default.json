{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "core:menu:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "core:window:allow-show",
    "core:window:allow-theme",
    "core:app:allow-version",
    "drag:default"
  ]
}
