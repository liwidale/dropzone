{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Dropzone",
  "version": "1.0.0",
  "identifier": "com.liwidale.dropzone",
  "build": {
    "beforeDevCommand": "npm run vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Dropzone",
        "width": 1120,
        "height": 740,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 22 },
        "windowEffects": { "effects": ["sidebar"], "state": "followsWindowActiveState" },
        "dragDropEnabled": true,
        "tabbingIdentifier": "dropzone"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; frame-src 'none'",
      "freezePrototype": true,
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Sorts your Downloads with rules you can preview and undo.",
    "copyright": "Copyright (c) 2026 Liwidale",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
